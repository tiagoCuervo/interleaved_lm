{
  "data_root": "data",
  "train_data": {
    "txt_datasets": ["finewebedu", "cosmopedia2", "pythonedu"],
    "audtxt_datasets": ["libriheavy", "swc", "stinystories"],
    "splits": ["train"],
    "p_strategies": [1, 0, 0, 0, 1],
    "txt_tokens": "smollm",
    "img_tokens": "pixel",
    "aud_tokens": "mimi",
    "audtxt_mode": "aligned",
    "block_size": 2048
  },
  "validation_data": {
    "txt_datasets": ["finewebedu"],
    "audtxt_datasets": ["libriheavy"],
    "splits": ["validation"],
    "p_strategies": [1, 0, 0, 0, 1],
    "txt_tokens": "smollm",
    "img_tokens": "pixel",
    "aud_tokens": "mimi",
    "audtxt_mode": "aligned",
    "block_size": 2048
  },
  "model": {
    "backbone": "HuggingFaceTB/SmolLM-1.7B",
    "backbone_revision": "646382037cc9ef78fa50842b0c95fc1cb7a608f9",
    "warm_init": true,
    "rope_theta": 100000.0,
    "predict_txt_special_tokens": true,
    "txt_pad_loss_weight": 0.5,
    "aud_inadapter_n_layers": 0,
    "aud_inadapter_dim": 2048,
    "aud_outadapter_n_layers": 0,
    "aud_outadapter_dim": 2048,
    "aud_codebook_transformer_layers": 2,
    "aud_codebook_transformer_dim": 256,
    "aud_codebook_transformer_mlp_dim": 1024,
    "aud_codebook_transformer_n_heads": 4,
    "aud_codebook_transformer_n_kvheads": 4,
    "aud_codebook_transformer_text_prefix": true,
    "aud_codebook_weights": [100, 1, 1, 1, 1, 1, 1, 1],
    "tie_aud_embeddings": false,
    "aud_delay_pattern": [0, 2, 2, 2, 2, 2, 2, 2],
    "aud_attention_residual": "none"
  },
  "training": {
    "output_dir": "out/moshi-speech-2b",
    "batch_size": 5,
    "gradient_accumulation_steps": 96,
    "max_steps": 1000000,
    "eval_interval": 1000,
    "eval_steps": 50,
    "log_interval": 10,
    "save_interval": 1000,
    "backbone_lr": 0.00003,
    "adapter_lr": 0.0002,
    "min_backbone_lr": 0.000003,
    "min_adapter_lr": 0.00002,
    "warmup_steps": 2000,
    "warmdown_steps": 100000,
    "precision": "bfloat16",
    "distributed": "fsdp",
    "compile": true
  }
}
